{
  "name": "dragon-browser",
  "productName": "Dragon Browser",
  "version": "0.1.0",
  "description": "Dragon Browser - Fast, private, built-in ad & tracker blocking browser",
  "main": "src/main/main.js",
  "author": {
    "name": "Dragon Browser Team",
    "email": "dragon-browser@project.local"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --universal --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never",
    "dist:all": "electron-builder -mwl --publish never"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.30.0",
    "cross-fetch": "^4.0.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.4",
    "extract-zip": "^2.0.1"
  },
  "build": {
    "appId": "com.dragonbrowser.app",
    "productName": "Dragon Browser",
    "publish": {
      "provider": "github",
      "owner": "ouail-messai",
      "repo": "dragon-browser",
      "releaseType": "release"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.png",
      "artifactName": "Dragon-Browser-Windows-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationLocation": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dragon Browser",
      "installerIcon": "build/icon.png",
      "uninstallerIcon": "build/icon.png",
      "installerHeaderIcon": "build/icon.png",
      "artifactName": "Dragon-Browser-Windows-Setup.exe",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "Dragon-Browser-macOS.dmg"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Network",
      "maintainer": "dragon-browser@project.local",
      "artifactName": "Dragon-Browser-Linux.${ext}"
    }
  }
}
